#!/usr/bin/env python3
"""Moves the simulator using a synthetic permutation fixture, never a student identity."""
import argparse
import json
from pathlib import Path
import rclpy
from ur3_llm_control.srv import GetState, ExecuteCommand
from ur3_llm_control.task_validator import WorldState, PlanValidator
from ur3_llm_control.student_task import student_mapping, safe_order

parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('--permutation',type=int,choices=range(6),default=0)
parser.add_argument('--report',type=Path)
args=parser.parse_args()
rclpy.init();node=rclpy.create_node('mapping_smoke_test')
report={'status':'FAIL','fixture_P':args.permutation}
def call(kind,name,request,timeout):
    c=node.create_client(kind,name)
    if not c.wait_for_service(timeout_sec=15):raise RuntimeError(name+' unavailable')
    future=c.call_async(request);rclpy.spin_until_future_complete(node,future,timeout_sec=timeout)
    if not future.done():raise RuntimeError(name+' timeout; execution uncertain, do not retry')
    return future.result()
try:
    state=WorldState.from_dict(json.loads(call(GetState,'/robot_skills/state',GetState.Request(),15).state_json))
    mapping=student_mapping(f'{args.permutation:02}')[2]
    plan=safe_order(mapping,state)
    PlanValidator().validate(plan,state,mapping)
    print('Synthetic mapping fixture P='+str(args.permutation)+'; student config unchanged',flush=True)
    response=call(ExecuteCommand,'/llm/command',ExecuteCommand.Request(plan_json=json.dumps(plan)),1800)
    result=json.loads(response.report_json)
    report.update({'plan':plan,'mapping':mapping,'command_report':result})
    if response.status!='TASK_SUCCESS':raise RuntimeError(response.report_json)
    final=WorldState.from_dict(result['state'])
    assert final.zone_occupancy==mapping and final.held_object is None and not final.faulted
    report['status']='PASS'
    print('PASS: multi-object execution and final mapping',flush=True)
    print(json.dumps(final.__dict__),flush=True)
except Exception as exc:
    report['error']=type(exc).__name__+': '+str(exc);print('FAIL:',report['error'],flush=True)
finally:
    if args.report:args.report.write_text(json.dumps(report,indent=2)+'\n')
    node.destroy_node();rclpy.shutdown()
raise SystemExit(0 if report['status']=='PASS' else 1)
