#!/usr/bin/env python3
"""Run six fresh headless Gazebo simulations in an isolated ROS domain."""
import argparse
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time
from ament_index_python.packages import get_package_prefix

p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--output',type=Path,required=True)
p.add_argument('--domain',type=int,default=83)
a=p.parse_args();a.output.mkdir(parents=True,exist_ok=True)
env=dict(os.environ,ROS_DOMAIN_ID=str(a.domain))
test=Path(get_package_prefix('ur3_llm_control'))/'lib/ur3_llm_control/all_pick_place_test'
reports=[]
for case in range(6):
    print('START CASE',case,flush=True)
    with (a.output/f'launch_{case}.log').open('w') as log:
        launch=subprocess.Popen(['ros2','launch','ur3_llm_control','llm_robot.launch.py',
            'gui:=false','rviz:=false',f'ign_partition:=ur3_verify_{a.domain}_{case}'],
            env=env,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
        result=None
        try:
            result=subprocess.run([sys.executable,str(test),'--case',str(case),
                '--report',str(a.output/f'case_{case}.json')],env=env,timeout=300)
        finally:
            # Signal only the process group created by this test runner.
            for sig in (signal.SIGINT,signal.SIGTERM):
                try:os.killpg(launch.pid,sig)
                except ProcessLookupError:break
                try:launch.wait(timeout=12)
                except subprocess.TimeoutExpired:continue
                if sig==signal.SIGTERM:break
            time.sleep(2)
    report_path=a.output/f'case_{case}.json'
    if report_path.exists():reports.append(json.loads(report_path.read_text()))
    (a.output/'summary.json').write_text(json.dumps(reports,indent=2)+'\n')
    if result is None or result.returncode:
        raise SystemExit(f'Case {case} failed; see {a.output}')
print('PASS: six assignments, nine source-to-tray pairs, six directed tray transfers and three same-tray replacements.',flush=True)
