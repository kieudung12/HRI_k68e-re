#!/usr/bin/env python3
"""Exercise a fresh simulation. Run cases 0..5 to cover all tray assignments."""
import argparse
import itertools
import json
import time
from pathlib import Path
import rclpy
import yaml
from ament_index_python.packages import get_package_share_directory
from moveit_msgs.srv import GetPlanningScene
from ur3_llm_control.srv import ExecuteSkill, GetState

p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--case',type=int,choices=range(6),required=True)
p.add_argument('--report',type=Path,required=True)
a=p.parse_args()
rclpy.init();node=rclpy.create_node('all_pick_place_test')
clients={}
report={'case':a.case,'status':'RUNNING','steps':[]}
cfg=yaml.safe_load((Path(get_package_share_directory('ur3_llm_control'))/'config/scene.yaml').read_text())
def call(kind,name,req,timeout=180):
    if name not in clients:clients[name]=node.create_client(kind,name)
    client=clients[name]
    assert client.wait_for_service(timeout_sec=60),name+' unavailable'
    f=client.call_async(req);rclpy.spin_until_future_complete(node,f,timeout_sec=timeout)
    assert f.done(),name+' timed out; stop simulation before retry'
    return f.result()
def state():
    return json.loads(call(GetState,'/robot_skills/state',GetState.Request()).state_json)
def step(skill,obj='',zone='',expected='SUCCESS'):
    before=state();start=time.monotonic()
    r=call(ExecuteSkill,'/robot_skills/execute',ExecuteSkill.Request(skill=skill,object=obj,zone=zone))
    after=json.loads(r.state_json)
    entry=dict(skill=skill,object=obj,zone=zone,status=r.status,seconds=round(time.monotonic()-start,2),state=after)
    report['steps'].append(entry);a.report.write_text(json.dumps(report,indent=2)+'\n')
    print(skill,obj,zone,r.status,entry['seconds'],flush=True)
    assert r.status==expected,(entry,r.message)
    assert not after['faulted'],after
    if expected!='SUCCESS':
        assert before==after,'Rejected command mutated state'
        return
    assert after['revision']==before['revision']+1
    req=GetPlanningScene.Request();req.components.components=1023
    scene=call(GetPlanningScene,'/get_planning_scene',req).scene
    attached={o.object.id for o in scene.robot_state.attached_collision_objects}
    world={o.id:o for o in scene.world.collision_objects}
    assert all(z+suffix in world for z in cfg['zones'] for suffix in ['_floor','_front','_back','_left','_right'])
    if skill=='pick':
        assert attached=={obj} and obj not in world and after['held_object']==obj
    if skill=='place':
        assert not attached and obj in world and after['held_object'] is None
        assert after['object_locations'][obj]==zone
        actual=world[obj].pose.position
        assert max(abs(v-w) for v,w in zip([actual.x,actual.y,actual.z],cfg['zones'][zone]))<0.005
try:
    assert state()['revision']==0,'Start from a fresh full simulation'
    step('place','red_cube','zone_a','INVALID_STATE')
    step('pick','unknown','','INVALID_OBJECT')
    step('unknown',expected='INVALID_SKILL')
    objects=['red_cube','yellow_cube','blue_cube']
    zones=list(itertools.permutations(['zone_a','zone_b','zone_c']))[a.case]
    report['mapping']=dict(zip(objects,zones))
    for i,(obj,zone) in enumerate(zip(objects,zones)):
        step('pick',obj)
        if i==0:
            step('pick',objects[1],'','INVALID_STATE')
            step('home',expected='INVALID_STATE')
            step('place',obj,'unknown','INVALID_ZONE')
        if i>0:step('place',obj,zones[0],'INVALID_STATE')
        step('place',obj,zone)
        if a.case==2:
            # Re-pick and replace each color in its own tray (A->A, B->B, C->C).
            step('pick',obj);step('place',obj,zone)
        if a.case==0 and i==0:
            # Directed Euler circuit covers every tray -> different tray pair.
            for destination in ['zone_b','zone_a','zone_c','zone_b','zone_c','zone_a']:
                step('pick',obj);step('place',obj,destination)
    step('home')
    report['status']='PASS'
except Exception as exc:
    report['status']='FAIL';report['error']=str(exc)
    print('FAIL',exc,flush=True)
finally:
    a.report.write_text(json.dumps(report,indent=2)+'\n')
    node.destroy_node();rclpy.shutdown()
raise SystemExit(0 if report['status']=='PASS' else 1)
