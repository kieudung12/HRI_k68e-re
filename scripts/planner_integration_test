#!/usr/bin/env python3
"""Live 9Router integration test; validates English, Vietnamese and real student mapping."""
import os
from pathlib import Path
import yaml
from ament_index_python.packages import get_package_share_directory
from ur3_llm_control.llm_planner import LLMPlanner
from ur3_llm_control.task_validator import PlanValidator, WorldState
from ur3_llm_control.student_task import student_mapping, build_trusted_context

missing=[key for key in ('NINEROUTER_BASE_URL','NINEROUTER_API_KEY','NINEROUTER_MODEL') if not os.environ.get(key)]
if missing:
    print('NOT VERIFIED: missing '+', '.join(missing))
    raise SystemExit(77)
try:
    share=Path(get_package_share_directory('ur3_llm_control'))
    config=yaml.safe_load((share/'config/student_config.yaml').read_text(encoding='utf-8'))
    xx,p,mapping=student_mapping(config['student_id'])
    context=build_trusted_context(WorldState(),(xx,p,mapping))
    planner=LLMPlanner(share/'prompt/planner_prompt.txt')
    validator=PlanValidator()
    cases=[('Put the red cube in zone B.','red_cube','zone_b'),
           ('Hãy lấy khối màu vàng và đặt nó vào vùng A.','yellow_cube','zone_a')]
    for text,obj,zone in cases:
        assert planner.classify_student_task(text) is False
        plan=planner.plan(text,context)
        result=validator.validate(plan)
        assert result.final_state.object_locations[obj]==zone
        print('PASS:',text)
    request='Arrange all objects according to my student ID.'
    assert planner.classify_student_task(request) is True
    plan=planner.plan(request,context)
    result=validator.validate(plan,required_mapping=mapping)
    assert result.final_state.zone_occupancy==mapping
    assert result.final_state.held_object is None
    assert result.steps[-1]=={"skill":"home"}
    print('PASS: real student mapping',f'XX={xx}',f'P={p}',mapping)
except Exception as exc:
    print('FAIL:',type(exc).__name__,str(exc))
    raise SystemExit(1)
