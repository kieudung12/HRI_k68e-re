<?xml version="1.0"?>
<sdf version="1.6">
  <world name="b8_empty">
    <physics name="step" type="ignored">
      <max_step_size>0.003</max_step_size><real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <scene>
      <ambient>0.75 0.75 0.75 1</ambient><background>0.80 0.85 0.91 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><direction>-0.5 -0.3 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse><cast_shadows>true</cast_shadows>
    </light>
    <!-- Chỉ có sàn chịu lực; không có tường, hộp hoặc vật cản. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="floor">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.01 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.72 0.77 0.83 1</ambient><diffuse>0.72 0.77 0.83 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
