<?xml version="1.0"?>
<plugin filename="GzScene3D" name="3D View">
  <ignition-gui><title>B7 Campus</title><property type="string" key="state">docked</property></ignition-gui>
  <engine>ogre2</engine><scene>scene</scene><camera_pose>0 -9 10 0 0.85 1.5708</camera_pose>
</plugin>
<plugin filename="WorldControl" name="World control">
  <ignition-gui><title>Play / Pause</title><property type="string" key="state">docked</property></ignition-gui>
  <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
</plugin>
<plugin filename="WorldStats" name="World stats">
  <ignition-gui><title>Simulation time</title><property type="string" key="state">docked</property></ignition-gui>
  <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor>
</plugin>
