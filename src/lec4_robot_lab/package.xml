<?xml version="1.0"?>
<package format="3">
  <name>lec4_robot_lab</name>
  <version>0.1.0</version>
  <description>Small TurtleBot 4 simulation lab with a custom practice world.</description>
  <maintainer email="student@example.com">LEC4 Student</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>irobot_create_msgs</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>turtlebot4_ignition_bringup</exec_depend>
  <exec_depend>irobot_create_ignition_bringup</exec_depend>
  <exec_depend>irobot_create_common_bringup</exec_depend>
  <exec_depend>turtlebot4_description</exec_depend>
  <exec_depend>irobot_create_description</exec_depend>
  <exec_depend>turtlebot4_ignition_gui_plugins</exec_depend>
  <exec_depend>irobot_create_ignition_plugins</exec_depend>
  <exec_depend>turtlebot4_navigation</exec_depend>
  <exec_depend>ros_ign_gazebo</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_media_path="${prefix}/worlds"/>
  </export>
</package>
