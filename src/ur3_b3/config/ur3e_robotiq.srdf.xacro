  <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="robotiq_85_right_pad" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_right_finger_tip_link" link2="robotiq_85_left_pad" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_right_finger_tip_link" link2="robotiq_85_right_pad" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_left_pad" link2="robotiq_85_right_pad" reason="Adjacent"/>
</robot>
