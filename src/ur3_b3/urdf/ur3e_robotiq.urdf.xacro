<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur">
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur3e"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="initial_positions_file" default="$(find ur_description)/config/initial_positions.yaml"/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="sim_ignition" default="false"/>
  <xacro:arg name="simulation_controllers" default=""/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/ur_to_robotiq_adapter.urdf.xacro"/>

  <link name="world"/>
  <xacro:ur_robot
    name="$(arg name)" tf_prefix="$(arg prefix)" parent="world"
    ur_type="$(arg ur_type)"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    sim_ignition="$(arg sim_ignition)"
    initial_positions="${xacro.load_yaml('$(arg initial_positions_file)')}">
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- Use the official UR-to-Robotiq adapter so the flange and gripper base
       meet physically instead of leaving a visible mounting gap. -->
  <xacro:ur_to_robotiq prefix="" parent="tool0" child="robotiq_mount"/>
  <xacro:robotiq_gripper name="robotiq" prefix="" parent="robotiq_mount" include_ros2_control="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper>

  <!-- Wide rubber pads make the physical finger contact stable on 35 mm cubes. -->
  <link name="robotiq_85_left_pad">
    <visual><geometry><box size="0.008 0.05 0.035"/></geometry>
      <material name="rubber_black"><color rgba="0.07 0.07 0.07 1"/></material></visual>
    <collision><geometry><box size="0.008 0.05 0.035"/></geometry></collision>
    <inertial><mass value="0.005"/><inertia ixx="1.55e-6" iyy="5.37e-7" izz="1.07e-6" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="robotiq_85_left_pad_joint" type="fixed">
    <parent link="robotiq_85_left_finger_tip_link"/><child link="robotiq_85_left_pad"/>
    <origin xyz="-0.022 0 0.022" rpy="0 0 0"/>
  </joint>
  <gazebo reference="robotiq_85_left_pad"><mu1>10</mu1><mu2>10</mu2></gazebo>

  <link name="robotiq_85_right_pad">
    <visual><geometry><box size="0.008 0.05 0.035"/></geometry>
      <material name="rubber_black"><color rgba="0.07 0.07 0.07 1"/></material></visual>
    <collision><geometry><box size="0.008 0.05 0.035"/></geometry></collision>
    <inertial><mass value="0.005"/><inertia ixx="1.55e-6" iyy="5.37e-7" izz="1.07e-6" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="robotiq_85_right_pad_joint" type="fixed">
    <parent link="robotiq_85_right_finger_tip_link"/><child link="robotiq_85_right_pad"/>
    <origin xyz="0.022 0 0.022" rpy="0 0 0"/>
  </joint>
  <gazebo reference="robotiq_85_right_pad"><mu1>10</mu1><mu2>10</mu2></gazebo>

  <!-- Fortress does not enforce all URDF mimic joints as a physical linkage.
       Command the six real simulated joints together through one stock controller. -->
  <ros2_control name="robotiq" type="system">
    <hardware><plugin>ign_ros2_control/IgnitionSystem</plugin></hardware>
    <joint name="robotiq_85_left_knuckle_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="robotiq_85_right_knuckle_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="robotiq_85_left_inner_knuckle_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="robotiq_85_right_inner_knuckle_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="robotiq_85_left_finger_tip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="robotiq_85_right_finger_tip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <xacro:if value="$(arg sim_ignition)">
    <gazebo>
      <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>$(arg simulation_controllers)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
