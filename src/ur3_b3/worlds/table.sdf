<?xml version="1.0"?>
<sdf version="1.7">
  <world name="ur3_b3">
    <physics name="default" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 2 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <model name="robot_pedestal"><static>true</static><pose>0 0 0.15 0 0 0</pose>
      <link name="support">
        <collision name="collision"><geometry><box><size>0.13 0.13 0.30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.13 0.13 0.30</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.30 0.30 0.32 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Table top is z=0.30 m, within the UR3e working envelope. -->
    <model name="table">
      <static>true</static><pose>0.45 0 0.285 0 0 0</pose>
      <link name="top">
        <collision name="collision"><geometry><box><size>0.60 0.72 0.03</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.60 0.72 0.03</size></box></geometry>
          <material><ambient>0.28 0.28 0.28 1</ambient><diffuse>0.32 0.32 0.32 1</diffuse></material></visual>
      </link>
      <link name="leg_left"><pose>0.22 -0.29 -0.15 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.035 0.035 0.27</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.035 0.035 0.27</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
      <joint name="leg_left_fixed" type="fixed"><parent>top</parent><child>leg_left</child></joint>
      <link name="leg_right"><pose>0.22 0.29 -0.15 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.035 0.035 0.27</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.035 0.035 0.27</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
      <joint name="leg_right_fixed" type="fixed"><parent>top</parent><child>leg_right</child></joint>
    </model>

    <!-- Thin visual markers have no collision; cubes rest on the table itself. -->
    <model name="zone_a"><static>true</static><pose>0.30 -0.16 0.301 0 0 0</pose><link name="marker">
      <visual name="visual"><geometry><box><size>0.085 0.085 0.001</size></box></geometry>
        <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
      <!-- Letter A, built from thin boxes because Fortress does not render
           SDF text geometry consistently. -->
      <visual name="label_a_left"><pose>-0.016 0 0.004 0 0 0</pose><geometry><box><size>0.006 0.040 0.004</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <visual name="label_a_right"><pose>0.016 0 0.004 0 0 0</pose><geometry><box><size>0.006 0.040 0.004</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <visual name="label_a_top"><pose>0 0.017 0.004 0 0 0</pose><geometry><box><size>0.026 0.006 0.004</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <visual name="label_a_mid"><pose>0 0 0.004 0 0 0</pose><geometry><box><size>0.026 0.006 0.004</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
    </link></model>
    <model name="zone_b"><static>true</static><pose>0.30 0 0.301 0 0 0</pose><link name="marker">
      <visual name="visual"><geometry><box><size>0.085 0.085 0.001</size></box></geometry>
        <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
      <!-- Letter B from thin boxes. -->
      <visual name="label_b_left"><pose>-0.016 0 0.004 0 0 0</pose><geometry><box><size>0.006 0.040 0.004</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <visual name="label_b_top"><pose>0 0.017 0.004 0 0 0</pose><geometry><box><size>0.026 0.006 0.004</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <visual name="label_b_mid"><pose>0 0 0.004 0 0 0</pose><geometry><box><size>0.026 0.006 0.004</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <visual name="label_b_bottom"><pose>0 -0.017 0.004 0 0 0</pose><geometry><box><size>0.026 0.006 0.004</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <visual name="label_b_upper"><pose>0.016 0.009 0.004 0 0 0</pose><geometry><box><size>0.006 0.014 0.004</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <visual name="label_b_lower"><pose>0.016 -0.009 0.004 0 0 0</pose><geometry><box><size>0.006 0.014 0.004</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
    </link></model>
    <model name="zone_c"><static>true</static><pose>0.30 0.16 0.301 0 0 0</pose><link name="marker">
      <visual name="visual"><geometry><box><size>0.085 0.085 0.001</size></box></geometry>
        <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
      <!-- Letter C from thin boxes. -->
      <visual name="label_c_left"><pose>-0.016 0 0.004 0 0 0</pose><geometry><box><size>0.006 0.040 0.004</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <visual name="label_c_top"><pose>0 0.017 0.004 0 0 0</pose><geometry><box><size>0.026 0.006 0.004</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <visual name="label_c_mid"><pose>0 -0.017 0.004 0 0 0</pose><geometry><box><size>0.026 0.006 0.004</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
    </link></model>

    <model name="red_cube"><pose>0.42 -0.16 0.319 0 0 0</pose><link name="body">
      <inertial><mass>0.04</mass><inertia><ixx>8.17e-6</ixx><iyy>8.17e-6</iyy><izz>8.17e-6</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.035 0.035 0.035</size></box></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><box><size>0.035 0.035 0.035</size></box></geometry><material><ambient>0.8 0.02 0.02 1</ambient><diffuse>0.9 0.02 0.02 1</diffuse></material></visual>
    </link></model>
    <model name="yellow_cube"><pose>0.42 0 0.319 0 0 0</pose><link name="body">
      <inertial><mass>0.04</mass><inertia><ixx>8.17e-6</ixx><iyy>8.17e-6</iyy><izz>8.17e-6</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.035 0.035 0.035</size></box></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><box><size>0.035 0.035 0.035</size></box></geometry><material><ambient>0.95 0.8 0.01 1</ambient><diffuse>0.95 0.8 0.01 1</diffuse></material></visual>
    </link></model>
    <model name="blue_cube"><pose>0.30 0 0.319 0 0 0</pose><link name="body">
      <inertial><mass>0.04</mass><inertia><ixx>8.17e-6</ixx><iyy>8.17e-6</iyy><izz>8.17e-6</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.035 0.035 0.035</size></box></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><box><size>0.035 0.035 0.035</size></box></geometry><material><ambient>0.02 0.08 0.85 1</ambient><diffuse>0.02 0.08 0.95 1</diffuse></material></visual>
    </link></model>
    <model name="green_cube"><pose>0.42 0.16 0.319 0 0 0</pose><link name="body">
      <inertial><mass>0.04</mass><inertia><ixx>8.17e-6</ixx><iyy>8.17e-6</iyy><izz>8.17e-6</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.035 0.035 0.035</size></box></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><box><size>0.035 0.035 0.035</size></box></geometry><material><ambient>0.02 0.7 0.04 1</ambient><diffuse>0.02 0.8 0.04 1</diffuse></material></visual>
    </link></model>
    <model name="purple_cube"><pose>0.42 0.08 0.319 0 0 0</pose><link name="body">
      <inertial><mass>0.04</mass><inertia><ixx>8.17e-6</ixx><iyy>8.17e-6</iyy><izz>8.17e-6</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.035 0.035 0.035</size></box></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><box><size>0.035 0.035 0.035</size></box></geometry><material><ambient>0.45 0.02 0.65 1</ambient><diffuse>0.55 0.02 0.75 1</diffuse></material></visual>
    </link></model>

    <model name="overhead_camera"><static>true</static><pose>0.38 0 1.15 0 0 0</pose>
      <link name="camera_link">
        <!-- Keep the housing behind the optical sensor so it does not appear
             in its own image. -->
        <visual name="camera_body"><pose>0 0 0.08 0 0 0</pose><geometry><box><size>0.12 0.12 0.08</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
        <visual name="camera_lens"><pose>0 0 0.035 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.012</length></cylinder></geometry>
          <material><ambient>0.02 0.05 0.08 1</ambient><diffuse>0.03 0.15 0.25 1</diffuse></material>
        </visual>
        <sensor name="rgb" type="camera"><pose>0 0 0 0 1.57079632679 0</pose>
          <always_on>true</always_on><update_rate>10</update_rate><topic>/camera</topic>
          <camera><horizontal_fov>1.15</horizontal_fov><image><width>800</width><height>800</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10</far></clip></camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
